PORT=5000
NODE_ENV=development

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173

# Secret used to sign login cookies. REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=workbench_development_jwt_secret_replace_in_prod

# ---------------------------------------------------------------
# DATABASE (choose one)
#
# 1) Local file (default). Leave MONGODB_URI empty or commented out.
#    Data is saved in backend/data/workbench-db.json. No setup needed.
#
# 2) MongoDB. Remove the # from the line below.
#    Local MongoDB or Docker (docker compose up -d):
#      MONGODB_URI=mongodb://127.0.0.1:27017/workbench
#    MongoDB Atlas:
#      MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/workbench
# ---------------------------------------------------------------
# MONGODB_URI=mongodb://127.0.0.1:27017/workbench

GITHUB_WEBHOOK_SECRET=change_me
